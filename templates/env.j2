# Docmost-Umgebungsdatei - enthaelt Secrets, daher chmod 600 und NICHT ins Repo.
# Wird von der Ansible-Rolle "docmost" gerendert.
APP_URL={{ docmost_app_url }}
APP_SECRET={{ _docmost_app_secret }}
DATABASE_URL=postgresql://{{ docmost_db_user }}:{{ _docmost_db_password }}@{{ docmost_db_host }}:{{ docmost_db_port }}/{{ docmost_db_name }}?schema=public
REDIS_URL={{ docmost_redis_url }}
PORT={{ docmost_http_port }}
FILE_UPLOAD_SIZE_LIMIT={{ docmost_file_upload_size_limit }}
DISABLE_TELEMETRY={{ 'true' if docmost_disable_telemetry else 'false' }}
# Nur fuer den db-Container (Compose-Variablen-Substitution):
DOCMOST_DB_PASSWORD={{ _docmost_db_password }}
{% if docmost_smtp_enabled %}
SMTP_HOST={{ docmost_smtp_host }}
SMTP_PORT={{ docmost_smtp_port }}
SMTP_USERNAME={{ docmost_smtp_username }}
SMTP_PASSWORD={{ docmost_smtp_password }}
SMTP_SECURE={{ 'true' if docmost_smtp_secure else 'false' }}
MAIL_FROM_ADDRESS={{ docmost_mail_from_address }}
MAIL_FROM_NAME={{ docmost_mail_from_name }}
{% endif %}

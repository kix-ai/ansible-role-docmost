# Nginx-Reverse-Proxy fuer Docmost. Wird von der Ansible-Rolle "docmost"
# gerendert. WebSocket-Upgrade ist fuer die Echtzeit-Zusammenarbeit erforderlich.
{% if docmost_tls_mode | default('none') == 'none' %}
server {
    listen 80;
    server_name {{ docmost_server_name }};

    client_max_body_size {{ docmost_nginx_client_max_body_size }};

    location / {
        proxy_pass http://{{ docmost_http_bind }}:{{ docmost_http_port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}
{% else %}
server {
    listen 80;
    server_name {{ docmost_server_name }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name {{ docmost_server_name }};

    ssl_certificate     {{ docmost_effective_tls_cert }};
    ssl_certificate_key {{ docmost_effective_tls_key }};

    client_max_body_size {{ docmost_nginx_client_max_body_size }};

    location / {
        proxy_pass http://{{ docmost_http_bind }}:{{ docmost_http_port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}
{% endif %}
